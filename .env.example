# Database
DATABASE_URL="postgresql://user:password@localhost:5432/easycad"

# Application
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3001"

# Authentication (JWT)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRY="7d"

# ER:LC API (backend only - never expose to frontend)
# Get your server key from https://erlc.link/sk
ERLC_SERVERS="[]"  # JSON array of server configs

# Example server config structure (do not expose to frontend):
# {
#   "communityId": "community-uuid",
#   "serverId": "server-uuid",
#   "serverKey": "your-server-key",
#   "serverUrl": "https://api.erlc.gg/v2"
# }

# Optional: For production deployment
DATABASE_SSL=true
LOG_LEVEL="info"
